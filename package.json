{
    "name": "reddviz",
    "version": "1.0.0",
    "description": "Serverless Reddit posts viewer deployed on Cloudflare Workers",
    "keywords": [],
    "license": "MIT",
    "author": "",
    "type": "module",
    "main": "src/index.ts",
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "lint": "oxlint",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "typecheck": "tsc --noEmit",
        "cf-typegen": "wrangler types --env-interface CloudflareBindings"
    },
    "dependencies": {
        "hono": "^4.13.8"
    },
    "devDependencies": {
        "@oxlint/plugins": "^1.83.0",
        "@types/node": "^26.6.1",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.83.0",
        "typescript": "^7.0.2",
        "wrangler": "^4.134.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "nub",
            "version": "^0.9.2",
            "onFail": "ignore"
        },
        "runtime": {
            "name": "node",
            "version": "26.9.0",
            "onFail": "ignore"
        }
    }
}
